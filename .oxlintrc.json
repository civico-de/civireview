{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "max-lines": ["error", { "max": 1000, "skipBlankLines": false, "skipComments": false }],
    "no-console": "off"
  },
  "ignorePatterns": ["node_modules", "dist"]
}
